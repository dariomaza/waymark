{
  "expo": {
    "name": "Waymark",
    "slug": "waymark",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "waymark",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#101011",
    "android": {
      "package": "dev.dariomaza.waymark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101011"
      }
    },
    "plugins": [
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Waymark uses the camera to read the QR code on a storage unit's label.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Waymark uses your photos so you can put a picture of a thing on it.",
          "cameraPermission": "Waymark uses the camera to photograph a thing or a box.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#101011"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c134d4b8-68bf-4ffe-8d81-c31417dd5580"
      }
    },
    "owner": "dariomaza"
  }
}
