# Path to the SQLite file the API stores its inventory in.
DATABASE_URL="file:./dev.db"

# Where the HTTP server listens.
#
# Loopback on purpose: `cloudflared` holds an OUTBOUND connection to Cloudflare
# and forwards requests here over the loopback interface, so nothing else ever
# needs to reach this port. Binding 0.0.0.0 would publish a private inventory to
# every device on the home network as a side effect of installing a tunnel.
HOST="127.0.0.1"
PORT="3000"

# Peers whose `CF-Connecting-IP` header is believed, comma separated.
#
# Behind a Cloudflare Tunnel the socket address is always the tunnel daemon, so
# the login rate limiter would otherwise count every caller in the world in one
# bucket. The header is only trusted from these addresses, because anyone who
# can reach the process directly can forge it. Defaults to 127.0.0.1 and ::1;
# set it to the daemon's address when cloudflared runs in its own container.
WAYMARK_TRUSTED_PROXIES="127.0.0.1,::1"

# Browser origins allowed to call the API, comma separated. Bare origins only:
# scheme, host and optional port, with no path and no trailing slash.
#
# The Expo Android app sends no `Origin` header and does not need to be listed.
WAYMARK_ALLOWED_ORIGINS="https://ariadna.example"

# Failed logins tolerated per client address, and the window they are counted
# in. Successful logins clear the counter.
WAYMARK_LOGIN_ATTEMPT_LIMIT="10"
WAYMARK_LOGIN_WINDOW_MINUTES="15"

# Where a scanned QR code sends a phone.
#
# The QR on a box encodes `<this>/u/<publicId>`, so pointing the stock Android
# camera at a label OPENS the page for that box instead of offering to copy an
# id. It must be the address of the WEB CLIENT, not of this API.
#
# Symbols are rendered on demand, not stored, precisely so that changing this
# value takes effect everywhere at once. Labels already printed against the old
# value keep pointing at it: the id glued to the box is stable, the hostname
# around it is not, so re-print the labels if this ever changes.
#
# Defaults to http://localhost:5173, the Vite dev server for the PWA.
WAYMARK_PUBLIC_BASE_URL="https://ariadna.example"

# The directory photo files live in.
#
# A plain directory, mounted as a Docker volume. It must NOT be inside the
# image, or an upgrade deletes every photo. Files are bucketed into 256
# subdirectories so no single directory ever holds tens of thousands of entries.
# Defaults to ./data/photos, relative to the working directory.
WAYMARK_PHOTO_ROOT="/data/photos"

# The largest single photo upload accepted, in megabytes.
#
# A 50 megapixel phone photo is 8-10 MB, so 12 accepts anything somebody
# actually points a camera at while keeping this endpoint from being a
# convenient way to fill a homelab disk. Stored photos are re-encoded and capped
# at 2048px on the longest edge regardless, so this is about the upload, not
# about what ends up on disk.
WAYMARK_MAX_PHOTO_MB="12"

# Only read by `pnpm --filter @waymark/api create-user`, and only as a last
# resort: piping the password on standard input is safer, and an interactive
# prompt safer still.
# WAYMARK_PASSWORD=""

# The background-removal sidecar's address.
#
# UNSET SWITCHES THE WHOLE FEATURE OFF: no processor, no worker, no polling.
# The app works completely without it, photos simply stay PENDING and the
# original is served (ADR 4). Uploading never calls the sidecar, so it cannot
# block or break registering an item however badly it is behaving.
#
# With the compose override it is http://image-processor:8000.
# WAYMARK_IMAGE_PROCESSOR_URL=""

# When one removal is abandoned as hung, in seconds.
#
# An order of magnitude past a slow ARM board's worst honest case. This exists
# to catch a sidecar that STOPPED answering, not to second-guess a slow one.
WAYMARK_IMAGE_PROCESSOR_TIMEOUT_SECONDS="120"

# Photos processed at once.
#
# One on purpose. onnxruntime already saturates every core for a single pass,
# so a second concurrent image buys no throughput: it halves both and doubles
# resident memory on the same box that is serving the API.
WAYMARK_IMAGE_PROCESSOR_CONCURRENCY="1"

# Attempts before a photo is abandoned as FAILED.
#
# Only transient failures (no answer, timeout, 5xx, 429) are retried, with
# backoff. A failure that is about the bytes rather than the sidecar goes
# FAILED on the first occurrence instead of spinning. Abandoned photos keep
# their reason and are visible on GET /photos/processing; the retry routes
# clear the attempt count so the button is not a no-op.
WAYMARK_IMAGE_PROCESSOR_MAX_ATTEMPTS="5"

# How often pending work is looked for when no upload woke the worker.
WAYMARK_IMAGE_PROCESSOR_POLL_SECONDS="15"
