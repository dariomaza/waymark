# Path to the SQLite file the API stores its inventory in.
DATABASE_URL="file:./dev.db"

# Where the HTTP server listens.
#
# Loopback on purpose: `cloudflared` holds an OUTBOUND connection to Cloudflare
# and forwards requests here over the loopback interface, so nothing else ever
# needs to reach this port. Binding 0.0.0.0 would publish a private inventory to
# every device on the home network as a side effect of installing a tunnel.
HOST="127.0.0.1"
PORT="3000"

# Peers whose `CF-Connecting-IP` header is believed, comma separated.
#
# Behind a Cloudflare Tunnel the socket address is always the tunnel daemon, so
# the login rate limiter would otherwise count every caller in the world in one
# bucket. The header is only trusted from these addresses, because anyone who
# can reach the process directly can forge it. Defaults to 127.0.0.1 and ::1;
# set it to the daemon's address when cloudflared runs in its own container.
ARIADNA_TRUSTED_PROXIES="127.0.0.1,::1"

# Browser origins allowed to call the API, comma separated. Bare origins only:
# scheme, host and optional port, with no path and no trailing slash.
#
# The Expo Android app sends no `Origin` header and does not need to be listed.
ARIADNA_ALLOWED_ORIGINS="https://ariadna.example"

# Failed logins tolerated per client address, and the window they are counted
# in. Successful logins clear the counter.
ARIADNA_LOGIN_ATTEMPT_LIMIT="10"
ARIADNA_LOGIN_WINDOW_MINUTES="15"

# Only read by `pnpm --filter @ariadna/api create-user`, and only as a last
# resort: piping the password on standard input is safer, and an interactive
# prompt safer still.
# ARIADNA_PASSWORD=""
