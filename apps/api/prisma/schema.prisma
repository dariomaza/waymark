// Waymark persistence schema.
//
// The domain in `packages/domain` knows nothing about this file. Everything
// here is a faithful projection of the domain entities onto SQLite, and the
// adapters in `src/persistence` are the only code allowed to read it.
//
// THIS FILE IS NOT THE WHOLE SCHEMA. The full-text search index — the
// `ItemSearch` and `StorageUnitSearch` virtual tables and the nine triggers
// that keep them in step (ADR 11) — lives only in
// `migrations/20260921090000_add_full_text_search_index`, because Prisma has
// no way to declare an FTS5 table or a trigger. Neither do the two triggers
// that keep `StorageUnit.ownerId` on roots only (ADR 26), which live in
// `migrations/20261001130000_root_spaces_have_owners_and_can_be_shared`.
//
// The consequence is a trap: `prisma migrate dev` diffs the database against
// THIS file, does not find them, and offers to DROP them. Accepting that
// leaves a product whose search answers nothing, quietly, with no error
// anywhere. Generate new migrations with `--create-only` and delete any
// `DROP TABLE "ItemSearch"` before applying. `src/persistence/search-index.test.ts`
// fails if one ever gets through.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ADR 1: a location is not an attribute of a storage unit, it IS a storage
/// unit. Plain adjacency list (`parentId`), walked with a recursive CTE. No
/// closure table and no materialized path: real depth in a homelab is 4-5
/// levels, and both alternatives buy read speed with write complexity nobody
/// here needs.
model StorageUnit {
  id       String  @id
  parentId String?

  /// `Restrict`, never `Cascade`. ADR 3 forbids destructive cascades in the
  /// domain; a schema that quietly disagreed would make the database the last
  /// word on a rule the domain owns.
  parent   StorageUnit?  @relation("StorageUnitTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children StorageUnit[] @relation("StorageUnitTree")

  /// Whose inventory this is (ADR 26). Set on a root and on nothing else:
  /// every space and item below a root belongs to the root's owner through the
  /// tree. The database keeps it so with two triggers (see the header).
  /// `Restrict`: an account that owns an inventory is disabled, never deleted.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  /// Presentational hint only (ADR 1). SQLite has no enum type and Prisma does
  /// not emulate one here, so the column is a string and the mapper rejects
  /// anything outside `StorageUnitKind` on the way out.
  kind        String
  description String?
  /// Cross-aggregate reference by id, deliberately not a foreign key: a photo
  /// has its own lifecycle (ADR 4) and may be uploaded, reprocessed or dropped
  /// independently of the unit that points at it.
  photoId     String?
  /// Printed inside the QR code, so it must be unique at the storage level and
  /// not merely by convention.
  publicId    String  @unique

  /// Written by the domain's `Clock` port. Deliberately NOT `@updatedAt`:
  /// letting Prisma stamp the time would put a second, invisible source of
  /// time next to the one the use cases are tested with.
  createdAt DateTime
  updatedAt DateTime

  items  Item[]
  shares Share[]
  /// Machine tokens narrowed to this space (ADR 26).
  machineTokens MachineTokenSpace[]

  @@index([parentId])
  @@index([ownerId])
  @@index([name])
}

/// A space shared with one person, at one level (ADR 26): `view` or `edit`,
/// covering everything under the space. On any space, never on an item.
///
/// One row per (space, person), so the pair has one answer. `Cascade` on both
/// sides, like `Session`: a share is a grant rather than inventory, and a grant
/// on a space or for a person that is gone means nothing.
model Share {
  storageUnitId String
  userId        String
  /// `view` | `edit`. A string for the same reason `StorageUnit.kind` is.
  access        String

  storageUnit StorageUnit @relation(fields: [storageUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([storageUnitId, userId])
  @@index([userId])
}

/// A thing stored inside exactly one storage unit.
model Item {
  id            String @id
  storageUnitId String

  storageUnit StorageUnit @relation(fields: [storageUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  description String?
  quantity    Int

  createdAt DateTime
  updatedAt DateTime

  tags   ItemTag[]
  photos ItemPhoto[]

  @@index([storageUnitId])
  @@index([name])
}

/// Tags are a child table rather than a JSON or comma separated column.
///
/// SQLite has no array type, so the alternatives were a serialized blob or
/// this. A blob turns "find everything tagged `winter`" into a `LIKE '%winter%'`
/// full scan that also matches `winterproof`; a child table makes it an indexed
/// equality lookup. Searching is half the point of the product (see README), so
/// the extra table pays for itself immediately.
///
/// The primary key is `(itemId, position)`, not `(itemId, tag)`: the domain
/// models tags as an ORDERED array that may legally repeat, and a key on the
/// tag itself would silently collapse duplicates and diverge from the in-memory
/// repository.
model ItemTag {
  itemId   String
  position Int
  tag      String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([itemId, position])
  @@index([tag])
}

/// Photo ordering lives here, on the item side, and NOWHERE else (ADR 9).
///
/// `Item.photos` is an ordered list of photo ids owned by the item aggregate,
/// while `Photo` is its own aggregate with an independent lifecycle (ADR 4:
/// uploaded synchronously, processed later, possibly never). Two aggregates
/// with independent lifecycles reference each other by id, not by foreign key,
/// so this table carries no FK to `Photo`: an item keeps its photo order even
/// while the corresponding photo rows are still being written by the upload
/// flow, and deleting an item releases its photos (ADR 3) instead of deleting
/// them.
///
/// Position 0 is the cover, which is simply `Item.photos[0]` in the domain.
/// `(itemId, position)` as the primary key makes "one photo per slot"
/// structural rather than a convention.
model ItemPhoto {
  itemId   String
  position Int
  photoId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([itemId, position])
  @@index([photoId])
}

/// ADR 4: background removal is optional and out of process, so the status is
/// part of the photo rather than an assumption about it. `originalPath` is
/// always written; reads fall back to it whenever `processedPath` is null.
model Photo {
  id               String  @id
  originalPath     String
  /// Written at upload, at the same time as the original, because a list view
  /// is the first screen anybody opens and the full image in a grid of 200
  /// items is unusable over mobile data. Stored rather than derived from
  /// `originalPath`: the directory layout is an adapter decision, and a row
  /// written under one layout must keep pointing at the file it wrote.
  thumbnailPath    String
  processedPath    String?
  /// PENDING | DONE | FAILED | SKIPPED. String for the same reason as
  /// `StorageUnit.kind`.
  processingStatus String

  /// ADR 9: there is deliberately NO `position` column here. Ordering is owned
  /// by whatever references the photo, and `ItemPhoto.position` is the only
  /// place any order is written or read. A second copy on this row was write
  /// only, went stale the moment an item's photos were reordered, and had no
  /// meaning at all for the single photo a storage unit points at.
  @@index([processingStatus])
}

/// What a background removal has already cost, and when it may be tried again.
///
/// It is deliberately NOT a queue. The queue is `Photo.processingStatus`, which
/// is the one place a photo's state is written (ADR 4), and this table holds
/// only what that column cannot express: how many attempts a photo has already
/// had, when the next one is due, which worker currently holds it, and why it
/// was abandoned. A row here means "there is history", never "there is work" —
/// so a lost insert cannot lose a photo, and a photo that was never written
/// here is simply one nobody has tried yet.
///
/// There is no foreign key to `Photo`, for the same reason nothing else in this
/// schema points at one: a photo is its own aggregate with its own lifecycle.
/// Rows whose photo is gone are swept on the next claim.
model PhotoProcessingAttempt {
  photoId String @id

  /// Incremented when a worker CLAIMS the photo, not when it finishes, so a
  /// process that dies mid-removal still counts its attempt and a crash loop
  /// is capped by the same rule as a sidecar that answers 500.
  attempts Int
  /// The backoff. A photo is invisible to `claim` until this moment passes.
  nextAttemptAt DateTime
  /// Held by whoever is processing it right now; `null` when nobody is. An
  /// expired lease is the same as no lease: the holder is assumed dead.
  leaseExpiresAt DateTime?
  /// Why the last attempt failed. Kept after the attempts run out, because
  /// "this photo was abandoned" is useless without "and here is what happened".
  lastError String?

  updatedAt DateTime

  @@index([nextAttemptAt])
}

/// An account: a person, their credentials, and their role (ADR 26).
///
/// Each person has an inventory of their own. Ownership is written on root
/// spaces only (`StorageUnit.ownerId`) and everything below a root belongs to
/// its owner through the tree; `Share` grants a person a space of somebody
/// else's. See ADR 26, which supersedes the single shared inventory of ADR 5.
model User {
  id           String @id
  /// Stored lower case. SQLite compares TEXT case sensitively and Postgres
  /// does too, so the normalization happens in the application rather than in a
  /// collation that would not survive the move between the two.
  username     String @unique
  /// `scrypt$N=...,r=...,p=...$<salt>$<digest>`. The parameters travel with the
  /// hash so they can be raised later without locking anybody out.
  passwordHash String
  /// `administrator` | `user`. A string because SQLite has no enum, checked on
  /// the way out like `StorageUnit.kind`. `user` by default, so an account that
  /// forgot to say what it is gets the narrower role: making an administrator
  /// is always written on purpose.
  role         String @default("user")

  createdAt DateTime
  updatedAt DateTime
  /// When an administrator disabled the account, or null while it is active
  /// (ADR 26). Accounts are disabled, never deleted: the row keeps owning its
  /// inventory. Every way in reads this column, so a session or a token left
  /// behind by an interrupted disable still opens nothing.
  disabledAt DateTime?

  sessions Session[]
  machineTokens MachineToken[]
  /// The roots this person owns; everything below them is theirs too.
  ownedStorageUnits StorageUnit[]
  shares Share[]
  passkeys Passkey[]
  /// Ceremonies this person has in flight. Rows live for two minutes.
  passkeyChallenges PasskeyChallenge[]
}

/// An opaque session token, stored hashed.
///
/// No JWT and no cookie. A JWT cannot be revoked without building the very
/// server-side table it was meant to avoid, and a cookie would need SameSite,
/// CSRF protection and a shared registrable domain that the Expo app does not
/// have. A random token in an `Authorization` header works identically for the
/// browser PWA and for the Android app, and revoking it is `DELETE FROM
/// "Session"`.
model Session {
  id String @id
  /// SHA-256 of the token. The token itself is shown once, at login, and never
  /// stored: a dump of this table contains nothing anybody can log in with.
  tokenHash String @unique

  userId String
  /// `Cascade` here, unlike everywhere else in this schema. ADR 3 is about not
  /// destroying inventory by accident; a session is not inventory, and a
  /// deleted account whose sessions kept working would be a security bug.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime
  expiresAt DateTime
  /// `password` | `passkey`. Which door this session was opened through, and
  /// the only thing anywhere that can tell (ADR 19).
  ///
  /// It exists for exactly one rule: a passkey may be registered only from a
  /// session that was opened with a password, because a credential that can
  /// issue its own successor outlives every password change — the same
  /// argument ADR 18 makes about a machine token minting a machine token. One
  /// column, read on one route. A string for the same reason `MachineToken.scope`
  /// is one: SQLite has no enum, so it is checked on the way out.
  createdWith String

  @@index([userId])
  @@index([expiresAt])
}

/// A device somebody can prove they are holding (ADR 19).
///
/// It is a CREDENTIAL, the third kind in this schema beside a password hash
/// and a machine token, and it is an ADDITIONAL way in rather than a
/// replacement: the password form never leaves the sign-in screen, and the
/// password — set by `create-user` or by an administrator (ADR 26) — is
/// untouched by any of this.
/// So removing every row here for a person locks nobody out of anything.
///
/// `Cascade`, like `Session` and unlike everything in the inventory: a deleted
/// account whose passkeys kept opening sessions would be a security bug, and
/// ADR 3's refusal of destructive cascades is about not destroying INVENTORY.
model Passkey {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// base64url, as the browser sends it. Unique across everybody, because a
  /// sign-in carries no username: this column is what decides whose session to
  /// open, so two people could not be allowed to share one value. Unique also
  /// means the presented id is one indexed read and never a scan that compares
  /// ids in application code.
  credentialId String @unique
  /// base64url of the COSE public key. Deliberately NOT hashed, unlike every
  /// other credential column in this file — it is a PUBLIC key, verification
  /// needs the key itself, and hashing it would make the row useless.
  publicKey    String
  /// What the authenticator said its signature counter was. Zero for most of
  /// them, for ever: a passkey synced across three devices cannot have one
  /// honest counter. See `src/auth/passkey.ts`.
  signCount    Int
  /// `internal,hybrid` — comma joined, empty when the browser reported none.
  /// A hint the platform uses to draw the right prompt; it describes the
  /// connection rather than the person, which is why it is kept when the
  /// AAGUID and the attestation are not.
  transports   String
  /// What the person called the device: "Pixel 8". How they decide which one
  /// to remove, months later, which is the only decision the list supports.
  label        String

  createdAt DateTime
  /// Stamped on every sign-in, unlike `MachineToken.lastUsedAt`, which is
  /// throttled to once an hour. That throttle exists because a machine reads
  /// in a loop; a person signs in a handful of times a week.
  lastUsedAt DateTime?

  @@index([userId])
}

/// One passkey ceremony in flight: the value an authenticator is about to
/// sign, and nothing else.
///
/// Rows live for two minutes and are deleted by being SPENT (ADR 19). Single
/// use is the `DELETE`, not a flag, because a flag makes it a read, a decision
/// and a write with a window in the middle — and a challenge that can be
/// signed twice turns a captured assertion into a permanent credential, which
/// is the whole attack this table exists to prevent.
model PasskeyChallenge {
  /// Opaque and random. This is what the client sends back, and it is
  /// deliberately not the challenge itself: addressing a row and signing a
  /// value are two jobs.
  id String @id

  /// `registration` | `authentication`. Part of the `WHERE` that spends the
  /// row, so a challenge issued to add a device cannot be spent signing in
  /// even if a handler forgot to compare.
  ceremony  String
  /// base64url, generated by the library, and what gets signed.
  challenge String

  /// Who this registration is for; `null` for a sign-in, which genuinely has
  /// nobody yet — that is what a discoverable credential means.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

/// A machine credential: named, long-lived, revocable on its own (ADR 17).
///
/// It belongs to the person who issued it and acts as that person, narrowed by
/// its scope (ADR 26). A machine using a person's PASSWORD still could not be
/// revoked without changing that password, which is why this is a credential
/// of its own rather than a session.
model MachineToken {
  id String @id
  /// What the token is FOR, in a human's words. Unique, because it is what
  /// `machine-token revoke --name` addresses, and revocation must never be a
  /// coin toss between two rows. Normalized lower case in the application, for
  /// the same reason `User.username` is.
  name String @unique
  /// SHA-256 of the token, which is shown once by the CLI and never stored.
  ///
  /// NOT scrypt, unlike `User.passwordHash`, and the reasoning is written out
  /// in `src/auth/machine-token-secret.ts`: the secret is 256 uniform random
  /// bits, so there is no dictionary for a slow KDF to make expensive, and the
  /// cost would land on every request a machine makes rather than on one login.
  /// Unique so a presented token is one indexed read and never a scan that
  /// compares digests in application code.
  tokenHash String @unique
  /// `read` | `read-write`. A string for the same reason `StorageUnit.kind` is:
  /// SQLite has no enum, so the value is checked on the way out by the mapper.
  scope String

  /// Who this token acts as. `Cascade`, like `Session`: a credential that kept
  /// working for an account that is gone would be a security bug, and ADR 3's
  /// refusal of destructive cascades is about inventory, not credentials.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime
  /// `null` means it never lapses, which is the normal case for a credential
  /// that lives in a compose file.
  expiresAt DateTime?
  /// Written at most once an hour, not once a request. A machine is the one
  /// caller that reads in a loop, and stamping every read would turn an
  /// inventory walk into forty writes on a single SQLite file.
  lastUsedAt DateTime?

  /// Whether this token was narrowed to chosen spaces (ADR 26). Its own fact,
  /// never inferred from `spaces`: the rows below go when a space is deleted,
  /// and a narrowed token whose spaces are all gone must reach nothing rather
  /// than widen to its issuer's whole reach. `false` is "no spaces chosen".
  narrowed Boolean @default(false)
  spaces   MachineTokenSpace[]

  @@index([expiresAt])
  @@index([userId])
}

/// A space a machine token was narrowed to (ADR 26). The token reaches what
/// its issuer reaches within this space and everything under it.
///
/// `Cascade` on both sides, like `Share`: this is a grant rather than
/// inventory. A deleted space takes its row with it, and the token's
/// `narrowed` stays true, so it never widens.
model MachineTokenSpace {
  machineTokenId String
  storageUnitId  String

  machineToken MachineToken @relation(fields: [machineTokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  storageUnit  StorageUnit  @relation(fields: [storageUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([machineTokenId, storageUnitId])
  @@index([storageUnitId])
}
