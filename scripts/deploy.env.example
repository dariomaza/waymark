# Copy to scripts/deploy.env (ignored by git) and fill in. Environment variables
# of the same name override anything here.

# SSH destination of the box that runs the container, as `user@host`.
WAYMARK_DEPLOY_REMOTE=user@your-server

# Directory on that box the repository is synced into; docker-compose.yml runs there.
WAYMARK_DEPLOY_PATH=/srv/waymark/src

# The public address the instance answers on. Also baked into every QR label.
WAYMARK_DEPLOY_PUBLIC_URL=https://waymark.example.com

# The GitHub repository whose CI must be green for the commit being deployed.
WAYMARK_DEPLOY_GITHUB_REPO=your-name/waymark

# Optional. Only for hosts where the login user cannot read the default Docker
# config directory — ZimaOS is one, and there the CLI silently finds no
# `docker compose` plugin at all.
# WAYMARK_DEPLOY_DOCKER_CONFIG=/srv/waymark/.docker

# Optional. 1 deploys with background removal: every compose command on the box
# uses docker-compose.image-processing.yml on top of docker-compose.yml, so the
# rembg sidecar is built and started alongside the API. Unset or 0 deploys the
# API alone, exactly as without this line. Anything else is refused.
# WAYMARK_DEPLOY_IMAGE_PROCESSING=1
