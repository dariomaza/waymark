# Everything the build does not need, and a few things it must never see.
node_modules
**/node_modules
.git
.gitignore

# Photos and databases are VOLUMES. Copying a developer's into the image would
# ship somebody's house to the server, and would be deleted by the next upgrade.
data
**/*.db
**/*.db-journal
**/*.sqlite

# Secrets. `.env.example` is documentation and is deliberately kept.
**/.env
**/.env.*
!**/.env.example

# `apps/web` is NOT here any more: the API serves the built client, so the
# image builds it (see `docker/api.Dockerfile`). Its `dist` is, though — the
# build inside the image is the only one that counts, and a developer's local
# one would be a stale copy riding in with the context.
apps/web/dist

apps/mobile
docs
README.md
